local LOGO_ID = "rbxassetid://8498174594"

local function make(class, props, parent)
	local i = Instance.new(class)
	for k, v in pairs(props or {}) do i[k] = v end
	if parent then i.Parent = parent end
	return i
end
local function corner(i, r) local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 9); c.Parent = i; return c end
local function stroke(i, col, tr, th)
	local s = Instance.new("UIStroke"); s.Color = col or T.Stroke; s.Transparency = tr or 0.45
	s.Thickness = th or 1; s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Parent = i
	return s
end
-- background-only gradient: always parent it to a frame that has nothing but a background
local function bgGradient(parent, a, b, rotation)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(a, b)
	if rotation then g.Rotation = rotation end
	g.Parent = parent
	return g
end
local function playClick()
	local s = Instance.new("Sound"); s.SoundId = "rbxassetid://83374956945112"; s.Volume = 0.2
	s.Parent = SoundService; s:Play(); Debris:AddItem(s, 1)
end
local function hover(btn, base, over, str)
	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(.2, Enum.EasingStyle.Quad), { BackgroundColor3 = over }):Play()
		if str then TweenService:Create(str, TweenInfo.new(.2), { Color = T.Accent, Transparency = 0.1 }):Play() end
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(.22, Enum.EasingStyle.Quad), { BackgroundColor3 = base }):Play()
		if str then TweenService:Create(str, TweenInfo.new(.22), { Color = T.Stroke, Transparency = 0.45 }):Play() end
	end)
end
local function ripple(btn)
	local mp = UserInputService:GetMouseLocation()
	local px = mp.X - btn.AbsolutePosition.X
	local py = mp.Y - btn.AbsolutePosition.Y
	local size = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 1.6
	local r = make("Frame", {
		Size = UDim2.new(0, 0, 0, 0), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, px, 0, py),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.75, BorderSizePixel = 0, ZIndex = 2,
	}, btn)
	corner(r, 999)
	TweenService:Create(r, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, size, 0, size), BackgroundTransparency = 1
	}):Play()
	Debris:AddItem(r, 0.5)
end

