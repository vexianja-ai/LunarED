local closing = false
local function tweenOut()
	if closing then return end
	closing = true
	local ti = TweenInfo.new(0.36, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(canvas, ti, { GroupTransparency = 1 }):Play()
	TweenService:Create(glow, ti, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(canvasStroke, ti, { Transparency = 1 }):Play()
	TweenService:Create(scale, ti, { Scale = 0.9 }):Play()
	local move = TweenService:Create(holder, ti, { Position = TARGET_POS + UDim2.fromOffset(0, 20) })
	move:Play()
	move.Completed:Wait()
	if sg.Parent then sg:Destroy() end
end

local function runScript(src)
	if type(src) ~= "string" or src == "" then return end
	if type(loadstring) ~= "function" then warn("[Lunar] loadstring unavailable"); return end
	local compiled, fn = pcall(loadstring, src)
	if not compiled or type(fn) ~= "function" then warn("[Lunar] script failed to compile"); return end
	local ok, err = pcall(fn)
	if not ok then warn("[Lunar] script error: " .. tostring(err)) end
end

local function launch(entry)
	playClick()
	tweenOut()
	local src = GAME_SCRIPTS[entry.placeId] or FALLBACK_SCRIPT
	if src and src ~= "" then
		task.spawn(function() runScript(src) end)
	else
		warn("[Lunar] no script set for " .. entry.name .. " (PlaceId " .. tostring(entry.placeId) .. ")")
	end
end

