	playClick()
	minimized = not minimized
	minBtn.Text = minimized and "+" or "-"
	body.Visible = not minimized
	local target = minimized and UDim2.fromOffset(MINI_W, MINI_H) or UDim2.fromOffset(PANEL_W, PANEL_H)
	TweenService:Create(holder, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = target }):Play()
end)

